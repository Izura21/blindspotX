{
  "name": "blindspot",
  "description": "Masque visuellement les posts d'une liste de comptes, sans les bloquer ni les mettre en sourdine.",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "zip:share": "node scripts/zip-share.mjs",
    "release": "node scripts/release.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "wxt build && node scripts/e2e-chromium.mjs",
    "lint:firefox": "wxt build -b firefox --mv3 && web-ext lint -s .output/firefox-mv3",
    "x:browser": "node scripts/x-browser.mjs",
    "smoke:x": "node scripts/smoke-x.mjs",
    "store:screenshots": "node scripts/store-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  },
  "license": "MIT"
}
